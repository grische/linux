// SPDX-License-Identifier: GPL-2.0
/*
 * AVM FRITZ!Box 7560 (HW221, GRX350) board-specific shared definitions.
 *
 * Phase 2 layers a persistent NAND-backed rootfs onto the Phase-1 RAM-boot
 * baseline. Partition labels, offsets, and sizes are reproduced byte-for-byte
 * from AVM's stock layout so that a vendor recovery (TFTP via the urlader)
 * can hand the kernel back to AVM-firmware without remapping flash.
 */

&ebu_nand {
	status = "okay";

	/* FRITZ!Box 7560's Macronix NAND is wired to EBU chip-select 1. */
	lantiq,cs = <1>;

	nand@0 {
		reg = <0>;
		label = "nand0";

		/*
		 * Macronix MX30LF1GE8AB on-die 4-bit BCH ECC. Selected via
		 * the legacy "nand-ecc-mode" binding; the modern
		 * "nand-ecc-engine" property is a phandle, not a string,
		 * and is not applicable when the chip itself is the ECC
		 * engine.
		 */
		nand-ecc-mode = "on-die";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * AVM urlader (first-stage bootloader). It also holds
			 * the only copy of the WiFi calibration data. Read-only:
			 * overwriting it bricks the device past the point of
			 * recovery without JTAG/SPI-flashing the chip.
			 */
			partition@0 {
				label = "urlader";
				reg = <0x0 0x100000>;
				read-only;
			};

			/*
			 * AVM TFFS environment. Holds the only copy of this
			 * device's identity (MAC addresses, serial number).
			 * Read-only: it is never written from Linux, and
			 * erasing it cannot be undone.
			 */
			partition@100000 {
				label = "nand-tffs";
				reg = <0x100000 0x400000>;
				read-only;
			};

			/* Primary kernel slot. Written by sysupgrade. */
			partition@500000 {
				label = "kernel";
				reg = <0x500000 0x800000>;
			};

			/* AVM secondary/recovery kernel slot. Written by sysupgrade. */
			partition@d00000 {
				label = "reserved-kernel";
				reg = <0xd00000 0x800000>;
			};

			/* UBI volume hosting rootfs / rootfs_data. */
			partition@1500000 {
				label = "ubi";
				reg = <0x1500000 0x6b00000>;
			};
		};
	};
};

&gswl {
	status = "okay";
};

&gswr {
	status = "okay";
};

/ {
	phy-xrx500@1c003c00 {
		compatible = "lantiq,phy-xrx500";
		reg = <0x1c003c00 0x280>;
		firmware-name = "lantiq/xrx500-phy-fw.bin";
		phy_id = <0x02 0x03 0x04 0x05>;
		resets = <&rcu_reset0 29 29>,
			 <&rcu_reset0 28 28>,
			 <&rcu_reset0 26 26>,
			 <&rcu_reset0 25 25>;
		reset-names = "phy2", "phy3", "phy4", "phy5";
		status = "okay";
	};

	gswip_mdio: gswip-mdio@1c003c10 {
		compatible = "lantiq,gswip-mdio";
		reg = <0x1c003c10 0x20>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/*
		 * Each label is consumed by the port whose intel,dp-port-id
		 * equals the GSWIP port number, and GSWIP port N == GPHY-N ==
		 * MDIO addr N. So the PHY address MUST match the consuming
		 * port's dp-port-id, NOT ascending order:
		 *   gphy_lan1 -> port@0 (dp-port-id 5) -> MDIO addr 5
		 *   gphy_lan2 -> port@1 (dp-port-id 4) -> MDIO addr 4
		 *   gphy_lan3 -> port@2 (dp-port-id 3) -> MDIO addr 3
		 *   gphy_lan4 -> port@3 (dp-port-id 2) -> MDIO addr 2
		 * The earlier ascending wiring (lan1->addr2 .. lan4->addr5)
		 * made each netdev's phylink monitor the WRONG GPHY: eth0
		 * (datapath GSWIP port 5) watched the PHY on port 2, so a
		 * cable on the port-5 jack never raised carrier on eth0.
		 */
		gphy_lan1: ethernet-phy@5 {
			reg = <0x05>;
		};

		gphy_lan2: ethernet-phy@4 {
			reg = <0x04>;
		};

		gphy_lan3: ethernet-phy@3 {
			reg = <0x03>;
		};

		gphy_lan4: ethernet-phy@2 {
			reg = <0x02>;
		};
	};

	intel_xrx500_net: ethernet {
		compatible = "intel,xrx500-net";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		port@0 {
			reg = <0>;
			intel,dp-port-id = <5>;
			phy-handle = <&gphy_lan1>;
		};

		port@1 {
			reg = <1>;
			intel,dp-port-id = <4>;
			phy-handle = <&gphy_lan2>;
		};

		port@2 {
			reg = <2>;
			intel,dp-port-id = <3>;
			phy-handle = <&gphy_lan3>;
		};

		port@3 {
			reg = <3>;
			intel,dp-port-id = <2>;
			phy-handle = <&gphy_lan4>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		cbm_std_pool: cbm-std-pool@23800000 {
			reg = <0x23800000 0x1200000>;
			no-map;
		};

		cbm_jbo_pool: cbm-jbo-pool@24a00000 {
			reg = <0x24a00000 0x800000>;
			no-map;
		};

		ramoops@23700000 {
			compatible = "ramoops";
			reg = <0x23700000 0x100000>;
			record-size = <0x4000>;
			console-size = <0x80000>;
			mem-type = <1>;
		};
	};
};

&cbm {
	memory-region = <&cbm_std_pool>, <&cbm_jbo_pool>;
	memory-region-names = "cbm-std-pool", "cbm-jbo-pool";
	status = "okay";
};

/ {
	/*
	 * Every line here is active low: the panel LEDs hang off 3V3 and
	 * the SoC pin sinks them, so driving the pin high extinguishes
	 * the LED. Confirmed on hardware, one GPIO at a time.
	 */
	leds {
		compatible = "gpio-leds";

		/*
		 * Bank 1, pin 4 == SoC pin 36. Lit as soon as the driver
		 * probes: the urlader already turns the power LED on, and
		 * blinking it off mid-boot would look like a failed boot.
		 * The led-boot / led-running aliases hand it to userspace
		 * afterwards.
		 */
		led_power: led-0 {
			label = "green:power";
			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		/* Vendor name: gpio_avm_led_internet. Drives "Fon". */
		led_fon: led-1 {
			label = "green:fon";
			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		/* Vendor name: gpio_avm_led_festnetz. Drives "DECT". */
		led_dect: led-2 {
			label = "green:dect";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_wlan: led-3 {
			label = "green:wlan";
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_info: led-4 {
			label = "green:info";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		/* Bank 1, pin 2 == SoC pin 34. */
		led_info_red: led-5 {
			label = "red:info";
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	/*
	 * Polled rather than interrupt-driven: the GPIO banks do not
	 * publish an irq domain (see xrx500.dtsi). 100 ms is fast enough
	 * for both the short-press and the long-press handlers.
	 */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		button-dect {
			label = "dect";
			linux,code = <KEY_PHONE>;
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
		};

		button-wlan {
			label = "wlan";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led-boot = &led_power;
		led-running = &led_power;
		led-failsafe = &led_info_red;
		led-upgrade = &led_info;
		led-wifi = &led_wlan;
	};
};

/*
 * DECT reset, active high. No DECT driver exists in this tree, so the
 * line is hogged and driven asserted at boot to hold the Dialog DECT
 * companion chip quiesced instead of leaving it half-initialised and
 * chattering on the shared SSI bus.
 */
&gpio0 {
	dect-reset-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "dect-reset";
	};
};

&pcie_phy0 {
	status = "okay";
	intel,ssc-enable = <1>;
};

&pcie_phy1 {
	status = "okay";
	intel,ssc-enable = <1>;
};

&pcie_phy2 {
	status = "okay";
	intel,ssc-enable = <1>;
};

/*
 * Inbound byte swapping is enabled on the two radio ports and disabled
 * on RC2. This SoC is big endian and the DWC core is not, so inbound
 * DMA is byte-swapped on the way through -- except for the VRX318,
 * whose driver already presents its shared memory in the endianness the
 * host expects, and swapping again would undo it. The vendor tree
 * arrives at the same split: grx_common.dtsi sets inbound-swap on all
 * three, and vrx318.dtsi, included only by boards carrying that chip,
 * clears it on RC2.
 *
 * Outbound is never swapped, on any port.
 */
&pcie0 {
	status = "okay";
	intel,inbound-swap = <1>;
	intel,outbound-swap = <0>;
	reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
};

&pcie1 {
	status = "okay";
	intel,inbound-swap = <1>;
	intel,outbound-swap = <0>;
	reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;

	/*
	 * The 2.4 GHz radio is an AR93xx whose EEPROM is blank, so it
	 * enumerates as 168c:abcd (AR9300_DEVID_INVALID). ath9k_of_init()
	 * only looks for calibration data in a file when the device has an
	 * OF node carrying qca,no-eeprom, so without this node the driver
	 * keeps AH_USE_EEPROM and the radio cannot come up at all -- there
	 * is nothing on the part to fall back to.
	 *
	 * The outer node is the root port at devfn 0 on bus 0, the inner
	 * one the endpoint at devfn 0 on bus 1; matching is by devfn, so
	 * the compatible is documentation.
	 */
	pcie@0 {
		reg = <0 0 0 0 0>;
		#size-cells = <2>;
		#address-cells = <3>;
		device_type = "pci";
		ranges;

		wifi@0,0 {
			compatible = "pci168c,abcd";
			reg = <0 0 0 0 0>;
			/* load from ath9k-eeprom-pci-0001:01:00.0.bin */
			qca,no-eeprom;
		};
	};
};

/* VRX318 DSL companion -- see the inbound-swap note above. */
&pcie2 {
	status = "okay";
	intel,inbound-swap = <0>;
	intel,outbound-swap = <0>;
	reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
};

/ {
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&usb1_phy {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};

&usb1 {
	status = "okay";
};
