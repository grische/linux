// SPDX-License-Identifier: GPL-2.0
/*
 * AVM FRITZ!Box 7560 (HW221, GRX350) board-specific shared definitions.
 *
 * Phase 2 layers a persistent NAND-backed rootfs onto the Phase-1 RAM-boot
 * baseline. Partition labels, offsets, and sizes are reproduced byte-for-byte
 * from AVM's stock layout so that a vendor recovery (TFTP via the urlader)
 * can hand the kernel back to AVM-firmware without remapping flash.
 */

&ebu_nand {
	status = "okay";

	/* FRITZ!Box 7560's Macronix NAND is wired to EBU chip-select 1. */
	lantiq,cs = <1>;

	nand@0 {
		reg = <0>;
		label = "nand0";

		/*
		 * Macronix MX30LF1GE8AB on-die 4-bit BCH ECC. Selected via
		 * the legacy "nand-ecc-mode" binding; the modern
		 * "nand-ecc-engine" property is a phandle, not a string,
		 * and is not applicable when the chip itself is the ECC
		 * engine.
		 */
		nand-ecc-mode = "on-die";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * AVM urlader (first-stage bootloader). Read-only:
			 * overwriting it bricks the device past the point of
			 * recovery without JTAG/SPI-flashing the chip.
			 */
			partition@0 {
				label = "urlader";
				reg = <0x0 0x100000>;
				read-only;
			};

			/*
			 * AVM TFFS environment (serial, MAC, calibration). Kept
			 * writable so the fritz-tffs userspace package can fix
			 * up serial/MAC entries in some recovery flows.
			 */
			partition@100000 {
				label = "nand-tffs";
				reg = <0x100000 0x400000>;
			};

			/* Primary kernel slot. Written by sysupgrade. */
			partition@500000 {
				label = "kernel";
				reg = <0x500000 0x800000>;
			};

			/* AVM secondary/recovery kernel slot. Written by sysupgrade. */
			partition@d00000 {
				label = "reserved-kernel";
				reg = <0xd00000 0x800000>;
			};

			/* UBI volume hosting rootfs / rootfs_data. */
			partition@1500000 {
				label = "ubi";
				reg = <0x1500000 0x6b00000>;
			};
		};
	};
};

&gswl {
	status = "okay";
};

&gswr {
	status = "okay";
};

/ {
	phy-xrx500@1c003c00 {
		compatible = "lantiq,phy-xrx500";
		reg = <0x1c003c00 0x280>;
		firmware-name = "lantiq/xrx500-phy-fw.bin";
		phy_id = <0x02 0x03 0x04 0x05>;
		resets = <&rcu_reset0 29 29>,
			 <&rcu_reset0 28 28>,
			 <&rcu_reset0 26 26>,
			 <&rcu_reset0 25 25>;
		reset-names = "phy2", "phy3", "phy4", "phy5";
		status = "okay";
	};

	gswip_mdio: gswip-mdio@1c003c10 {
		compatible = "lantiq,gswip-mdio";
		reg = <0x1c003c10 0x20>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/*
		 * Each label is consumed by the port whose intel,dp-port-id
		 * equals the GSWIP port number, and GSWIP port N == GPHY-N ==
		 * MDIO addr N. So the PHY address MUST match the consuming
		 * port's dp-port-id, NOT ascending order:
		 *   gphy_lan1 -> port@0 (dp-port-id 5) -> MDIO addr 5
		 *   gphy_lan2 -> port@1 (dp-port-id 4) -> MDIO addr 4
		 *   gphy_lan3 -> port@2 (dp-port-id 3) -> MDIO addr 3
		 *   gphy_lan4 -> port@3 (dp-port-id 2) -> MDIO addr 2
		 * The earlier ascending wiring (lan1->addr2 .. lan4->addr5)
		 * made each netdev's phylink monitor the WRONG GPHY: eth0
		 * (datapath GSWIP port 5) watched the PHY on port 2, so a
		 * cable on the port-5 jack never raised carrier on eth0.
		 */
		gphy_lan1: ethernet-phy@5 {
			reg = <0x05>;
		};

		gphy_lan2: ethernet-phy@4 {
			reg = <0x04>;
		};

		gphy_lan3: ethernet-phy@3 {
			reg = <0x03>;
		};

		gphy_lan4: ethernet-phy@2 {
			reg = <0x02>;
		};
	};

	intel_xrx500_net: ethernet {
		compatible = "intel,xrx500-net";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		port@0 {
			reg = <0>;
			intel,dp-port-id = <5>;
			phy-handle = <&gphy_lan1>;
		};

		port@1 {
			reg = <1>;
			intel,dp-port-id = <4>;
			phy-handle = <&gphy_lan2>;
		};

		port@2 {
			reg = <2>;
			intel,dp-port-id = <3>;
			phy-handle = <&gphy_lan3>;
		};

		port@3 {
			reg = <3>;
			intel,dp-port-id = <2>;
			phy-handle = <&gphy_lan4>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		cbm_std_pool: cbm-std-pool@23800000 {
			reg = <0x23800000 0x1200000>;
			no-map;
		};

		cbm_jbo_pool: cbm-jbo-pool@24a00000 {
			reg = <0x24a00000 0x800000>;
			no-map;
		};
	};
};

&cbm {
	memory-region = <&cbm_std_pool>, <&cbm_jbo_pool>;
	memory-region-names = "cbm-std-pool", "cbm-jbo-pool";
	status = "okay";
};
