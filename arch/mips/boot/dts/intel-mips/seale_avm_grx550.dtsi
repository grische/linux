/*
 * AVM FRITZ!Box boards on the GRX550 die. Die-variant layer between
 * seale_avm.dtsi and the board files: the fifth GPHY and its WAN port, the
 * second MDIO bus, the front-panel LED controller and both USB host
 * controllers.
 */

#include <dt-bindings/clock/intel,grx500-clk.h>
#include <dt-bindings/gpio/gpio.h>

#include "seale_avm.dtsi"

/ {
	/*
	 * One enable line feeds both USB PHYs. Both take it as their
	 * vbus-supply, which is legal and refcounted:
	 * regulator_get_optional() is not an exclusive get, so a second
	 * consumer is not turned away.
	 */
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The blink generator's slow clock source: a fixed 8 kHz input the
	 * driver divides for its blink table.
	 */
	sso_fpid: clock-8000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <8000>;
	};

	/*
	 * The front-panel LED controller. Four constraints:
	 *
	 * - "syscon" must stay in the compatible or syscon_node_to_regmap()
	 *   fails.
	 * - The clock-names order matters: clock 0 gates register access.
	 * - The compatible selects the falling shift-clock edge. The vendor
	 *   driver
	 * defaults this SoC to the falling edge and treats rising as an
	 * opt-in
	 * device-tree property that no board sets; mainline's lgm-sso
	 * hardcodes
	 * rising instead.
	 * - ngpios narrows the controller to the populated pins.
	 */
	ssogpio: ssogpio@16d00000 {
		compatible = "intel,grx500-ssoled", "syscon";
		reg = <0x16d00000 0x2cc>;

		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;

		clocks = <&cgu GCLK_SSO>, <&sso_fpid>;
		clock-names = "sso", "fpid";

		intel,sso-update-rate-hz = <250000>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ledc>;
	};
};

/*
 * The second switch macro, which is where this die's WAN socket lands. It is
 * a tree of its own with a conduit of its own: nothing forwards between the
 * two macros in hardware, so a bridge spanning them would blackhole, and a
 * conduit carries exactly one CPU port.
 */
&gswr {
	status = "okay";

	/*
	 * The same sub-aperture of the same block as the LAN macro's bus, so
	 * the driver reaches it through the identical offset from this node's
	 * own window.
	 *
	 * The address on the bus is 1, which is the number of the register
	 * slots the external port's PHY address is written into. It has
	 * nothing to do with the port's own number.
	 */
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		gphy_wan: ethernet-phy@1 {
			compatible = "ethernet-phy-idd565.a409",
				     "ethernet-phy-ieee802.3-c22";
			reg = <0x01>;
		};
	};

	ports {
		port@f {
			reg = <15>;
			label = "wan";
			phy-mode = "internal";
			phy-handle = <&gphy_wan>;
		};
	};
};

&conduit_wan {
	status = "okay";
};

/*
 * The fifth integrated PHY, which carries the WAN socket. On this die request
 * bit 31 is that core's own reset line and not a group master reset, which is
 * how the vendor device tree names it. Its status is reported in bit 30, and
 * bit 31 of the status register belongs to the watchdog instead.
 */
&gphy_fw {
	gphy@f9a {
		reg = <0xf9a>;
		resets = <&rcu_reset0 31 30>;
		reset-names = "gphy";
	};
};

&usb0_phy {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};

&usb0 {
	status = "okay";
};

&usb1_phy {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};

&usb1 {
	status = "okay";
};

/*
 * The three pads the shift register hangs off. Both spellings are required:
 * the pinctrl driver rejects a child that has "groups" without "pins" or
 * "pinmux", and it fails the whole pinctrl probe when it does.
 */
&pinctrl {
	pinctrl_ledc: led-pins {
		pins = <4>, <5>, <6>;
		function = "led";
		pinmux = <1>, <1>, <1>;
		groups = "led";
	};
};
