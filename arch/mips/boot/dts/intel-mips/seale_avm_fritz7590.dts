/*
 * AVM FRITZ!Box 7590 (HW226), GRX550. Board-specific data only; the SoC is
 * described in xrx500.dtsi, the board family in seale_avm.dtsi and the die
 * variant in seale_avm_grx550.dtsi.
 */
/dts-v1/;

#include <dt-bindings/clock/intel,grx500-clk.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "seale_avm.dtsi"

/ {
	model = "AVM FRITZ!Box 7590";
	compatible = "avm,fritz7590", "intel,xrx500";

	/*
	 * The boot loader carries a table of device-tree blobs keyed by
	 * hardware sub-revision. Declaring the tag is cosmetic here — the
	 * loader passes this kernel no device tree and the appended blob is
	 * parsed unconditionally — but it stops the loader reporting an
	 * unmatched sub-revision.
	 */
	avm-hw-revision {
		compatible = "avm,avm_hw_revision";
		revision = "226";
		subrevision = "4";
	};

	/*
	 * Capped at the top of the uncached window (PHYS_OFFSET + SZ_256M):
	 * above it the KSEG1 alias of a page is a register address, so no
	 * coherent allocation may land there.
	 */
	memory@20000000 {
		device_type = "memory";
		reg = <0x20000000 0x10000000>;
	};

	/*
	 * These aliases name the boot, failsafe and upgrade lamps for
	 * userspace; without them the boot-progress indication is silently
	 * absent.
	 */
	aliases {
		serial0 = &asc0;

		led-boot = &led_power;
		led-running = &led_power;
		led-failsafe = &led_info_red;
		led-upgrade = &led_info;
		led-wifi = &led_wlan;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * Unused while MIPS_CMDLINE_BUILTIN_EXTEND is selected;
		 * present so a board that needs its own arguments has
		 * somewhere to put them.
		 */
		bootargs = "";
	};

	/*
	 * Every region below must stay under PHYS_OFFSET + SZ_256M; the
	 * uncached alias above that address reaches registers, not DRAM.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Crash persistence, at the address the vendor's own device
		 * tree uses for it (its node is named ramoops@20500000 while
		 * its reg says 0x20100000). 1 MiB of the 4 MiB region below
		 * _text. The zone sizes fill reg exactly; fs/pstore/ram.c
		 * fails the whole probe if they overflow it.
		 */
		ramoops@20100000 {
			compatible = "ramoops";
			reg = <0x20100000 0x100000>;
			record-size = <0x4000>;
			console-size = <0x80000>;
			mem-type = <1>;
		};

		/*
		 * Owned by the second CPU's boot loader (the vendor ships its
		 * own device tree for that core); no-map so this kernel never
		 * maps another CPU's memory.
		 */
		cpunet@2dfc0000 {
			reg = <0x2dfc0000 0x40000>;
			no-map;
		};

		bootcore@2e000000 {
			reg = <0x2e000000 0x2000000>;
			no-map;
		};

		/*
		 * Fixed-address seed buffer shared with the second CPU;
		 * reserved no-map so nothing here maps or reads it.
		 */
		shm-rng-seed@3dfb0000 {
			reg = <0x3dfb0000 0x1000>;
			no-map;
		};
	};

	/*
	 * Port power, for both USB host controllers at once. The FRITZ!Box 7560 has
	 * one port and one enable line; this board has two ports and still
	 * one enable line. AVM declares a single gpio_avm_usb_power_enable
	 * on gpio1 2, active high, with no per-controller variant (AVM 4.9
	 * arch/mips/boot/dts/lantiq/avm/grx550_common.dtsi). That is gpio
	 * bank 1 line 2, i.e. pad 34, and nothing else on this board claims
	 * it.
	 *
	 * Both PHYs take it as their vbus-supply, which is legal and
	 * refcounted: the PHY driver asks with regulator_get_optional(), and
	 * only an exclusive get would turn a second consumer away. Whichever
	 * PHY powers on first raises the line and it drops again when the
	 * last one powers off.
	 *
	 * The vendor mechanism, and the reason for not reproducing it, are
	 * the FRITZ!Box 7560's: see the comment on that board's usb_vbus.
	 *
	 * No pinmux, for the same reason as there: the pad comes up as a
	 * GPIO, which is what the regulator needs.
	 */
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

/*
 * Toshiba BENAND, 512 MiB with a 4 KiB page; the geometry is self-identified.
 * The partition map is the one the vendor boot loader installs, so a vendor
 * recovery can hand the kernel back to the original firmware without
 * remapping flash.
 */
&nand0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * First-stage boot loader, and the only copy of the Wi-Fi
		 * calibration data. Read-only: overwriting it bricks the
		 * device past the point of recovery without an external
		 * programmer.
		 */
		partition@0 {
			label = "urlader";
			reg = <0x0 0x100000>;
			read-only;
		};

		/*
		 * AVM TFFS environment: the only copy of this unit's
		 * identity (MAC addresses, serial number). Never
		 * written from Linux, and erasing it cannot be undone.
		 */
		partition@100000 {
			label = "nand-tffs";
			reg = <0x100000 0x400000>;
			read-only;
		};

		/*
		 * Two 8 MiB kernel slots, named by position: which one is
		 * active is boot-loader run-time state (its linux_fs_start
		 * selects between them), so no label may claim to be the
		 * active one.
		 */
		partition@500000 {
			label = "kernel0";
			reg = <0x500000 0x800000>;
		};

		partition@d00000 {
			label = "kernel1";
			reg = <0xd00000 0x800000>;
		};

		/* UBI: rootfs and rootfs_data. Ends at the 512 MiB mark. */
		partition@1500000 {
			label = "ubi";
			reg = <0x1500000 0x1eb00000>;
		};
	};
};

/*
 * All five GPHYs. The first four are the ones the FRITZ!Box 7560 also has -- silicon
 * ids 0x02..0x05 on RCU reset bits 29 / 28 / 26 / 25 -- and the fifth, silicon
 * id 0x0F on bit 31, is this board's WAN PHY. The bits are non-contiguous and
 * out of order: 29, 28, 26, 25, 31, with 27 unused. No closed form fits them,
 * which is why every entry is spelled out.
 *
 * That reading does not carry over to the GRX550. The vendor's own device
 * tree names bit 31 "phy4" -- the fifth GPHY's individual reset line --
 * alongside 29/28/26/25 for phy0..phy3 and bit 30 for the global chip reset,
 * and its console boots all five GPHYs from this one GSW-L-side block.
 *
 * The second cell is the RST_STAT status bit. It is inert on this path: the
 * firmware loader takes the reset_control handle only so the named-line
 * lookup succeeds and then discards it outright -- xrx500_phy_fw.c:257,
 * "(void)phy_rst" -- and drives RCU_RST_REQ by direct read-modify-write
 * instead (:297 assert, :322 deassert), with the bit coming from its own
 * xrx500_gphy[] table rather than from the DT. Neither cell ever reaches the
 * provider's .status op, which is the only thing in the reset framework that
 * reads the status register. Both cells must still clear the provider's "<
 * nr_resets" bounds check, which 31 does.
 *
 * The aperture in seale_avm.dtsi is already sized for five: GPHYF's LBADR and
 * MBADR sit at offsets 0x268 and 0x26C, inside reg = <0x1c003c00 0x280>.
 *
 * All five entries are load-bearing for every port, not just the WAN one. A
 * PHY with no firmware does not answer MDIO; of_mdiobus_register tolerates
 * that and brings the bus up without it, but no phy_device is created, so
 * phylink_of_phy_connect -> phylink_fwnode_phy_connect returns -ENODEV rather
 * than -EPROBE_DEFER. Probe requires every declared port to come up, so that
 * one failure rolls the four working LAN netdevs back with it.
 */
&gphy_fw {
	phy_id = <0x02 0x03 0x04 0x05 0x0F>;
	resets = <&rcu_reset0 29 29>,
		 <&rcu_reset0 28 28>,
		 <&rcu_reset0 26 26>,
		 <&rcu_reset0 25 25>,
		 <&rcu_reset0 31 31>;
	reset-names = "phy2", "phy3", "phy4", "phy5", "phyF";
};

/*
 * The second MDIO bus, on the GSW-R instance, carrying this board's WAN PHY.
 *
 * The aperture is the GSW-L arithmetic in seale_avm.dtsi applied to the GSW-R
 * base: gswr_base + (MDCTRL DWORD 0x004 + GSW30_TOP_OFFSET 0xF00) * 4 =
 * 0x1a000000 + 0x3c10. Same 0x20 span covering MDCTRL/MDREAD/MDWRITE and the
 * two MDCCFG registers, same intentional overlap with gswr@1a000000's 0x4000
 * reg claim, same devm_ioremap-without-request_mem_region shape that makes
 * the overlap harmless.
 *
 * If the arithmetic is wrong the symptom is specific: reads on this bus
 * return 0xFFFF and the WAN PHY never enumerates, while the LAN bus is
 * unaffected.
 *
 * Everything else the driver needs is read from the child below.
 *
 * The PHY is at MDIO address 1. The "MDIO address == dp-port-id" rule
 * documented on the GSW-L bus is a GSW-L coincidence and stops here: this
 * PHY's port is dp-port-id 15, and writing ethernet-phy@15 would name an
 * address that does not exist.
 */
/ {
	gswr_mdio: gswip-mdio@1a003c10 {
		compatible = "lantiq,gswip-mdio";
		reg = <0x1a003c10 0x20>;
		lantiq,gswip-instance = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		gphy_wan: ethernet-phy@1 {
			reg = <0x01>;
		};
	};
};

/*
 * The WAN port, on the second GSWIP instance.
 *
 * intel,dp-port-id = <15> is not a free choice: DP_F_FAST_ETH_WAN drives the
 * datapath allocator over a range whose start and end are both
 * PMAC_ETH_WAN_ID, so the WAN class can only ever land on datapath port 15.
 * The driver rejects a lantiq,wan on any other port rather than quietly
 * giving it the wrong PMAC template.
 *
 * lantiq,wan is what selects that template. It is not redundant with the port
 * id: the two Ethernet classes differ only in the PMAC redirect bit, which no
 * address or phy property implies, and it is the property the vendor's own
 * board glue reads.
 *
 * From here the CQM resolves the rest out of its ported vendor tables --
 * dequeue port 19 (which is also the TMU egress port), TMU queue 28,
 * scheduler block 12, DMA1TX channel 15. Note the controller: every LAN port
 * egresses via DMA2TX, this one does not.
 *
 * This port depends on the fifth GPHY's firmware entry, which &gphy_fw above
 * carries along with the other four. Probe requires every declared port to
 * come up, so that one failure would roll the four working LAN netdevs back
 * with it and leave the board with no ethernet at all.
 */
&intel_xrx500_net {
	port@4 {
		reg = <4>;
		intel,dp-port-id = <15>;
		lantiq,wan;
		phy-handle = <&gphy_wan>;
	};
};

/*
 * RC0 and RC1 carry the two QCA9984 radios; RC2 carries a VRX518 with no
 * in-tree driver. Inbound byte swapping stays on: the SoC is big-endian and
 * the DesignWare core is not.
 */
&pcie2 {
	status = "okay";
	intel,inbound-swap = <1>;
	intel,outbound-swap = <0>;
	reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
};

/*
 * Both USB host controllers. The vendor's HW226 chain carries no status
 * override on either of them, where the FRITZ!Box 7560's grx350_common.dtsi disables
 * usb0. How many jacks that reaches, and which controller sits behind each
 * one, is a board-layout fact the vendor sources do not state.
 */
&usb0_phy {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};

&usb0 {
	status = "okay";
};

&usb1_phy {
	status = "okay";
	vbus-supply = <&usb_vbus>;
};

&usb1 {
	status = "okay";
};

/*
 * Front-panel LEDs and buttons.
 *
 * The lamps are not GPIOs. They hang off the SoC's Serial Shift Output
 * controller, which clocks a 32-bit output word out to an external shift
 * register on three pads -- shift clock, store and data -- and holds an
 * eight-bit duty cycle per pin. Six of the seven pins declared below are
 * visible lamps; the seventh is a brightness carrier that is not.
 *
 * Everything here is board-local, and the pin group is why. The pinmux
 * driver's eqbr_build_groups() walks every child of the pinmux node, enabled
 * or not, and returns -EINVAL for the first one missing "pins" or "pinmux" --
 * which fails the whole pinctrl probe, not just that group. On this platform
 * that would take every GPIO consumer with it, and the other board on it has
 * no remote power. The SSO node follows it here for the same reason and
 * because putting either in xrx500.dtsi renumbers phandles through the
 * FRITZ!Box 7560's blob for no gain. Promote both the day a second board wires this
 * function.
 */
/ {
	/*
	 * The blink generator's slow clock source. AVM models it as a
	 * fixed-clock at 8 kHz (AVM 4.9 arch/mips/boot/dts/lantiq/
	 * xrx500.dtsi, afeclk), and the number is self-checking: the driver
	 * divides it by {4000, 2000, 1000, 800} for its first four blink
	 * rates, giving the 2/4/8/10 Hz that both its own freq_tbl[] and the
	 * vendor's carry as a literal.
	 *
	 * It is a real input rather than a placeholder, but not one this
	 * board uses: hardware blink is only wired up for pins 24 and above,
	 * and every pin here is below that.
	 */
	sso_fpid: clock-8000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <8000>;
	};

	/*
	 * Address and window are the vendor's -- ssogpio@d00000 under the
	 * ssx4 wrapper whose ranges add 0x16000000 (AVM 4.9
	 * arch/mips/boot/dts/lantiq/xrx500.dtsi). The 0x2cc size ends one
	 * word past the last register, SSO_CON3 at +0x2c8, so the whole
	 * block is reachable.
	 *
	 * "syscon" in the compatible is load-bearing. The driver takes its
	 * regmap from syscon_node_to_regmap(), which hands back -EINVAL for
	 * a node whose compatible does not carry that exact string, so
	 * without it the driver does not probe at all. The same call
	 * attaches of_clk_get(np, 0) to the regmap as the gate on register
	 * access, which is why clock-names is ordered sso first: the order
	 * is a requirement, not a convention.
	 *
	 * intel,grx500-ssoled rather than the intel,lgm-ssoled the driver
	 * shipped with, and the whole difference is one bit. Mainline
	 * hardcodes SSO_CON0.RZFL to 0, clocking the shift register on the
	 * rising edge. The driver now carries the edge as per-compatible
	 * match data and this compatible selects it.
	 *
	 * ngpios and the update rate have no useful defaults and both are
	 * checkable. ngpios narrows the SoC's 16 pins to the 8 this board
	 * populates, which is what leaves a single group-enable bit in
	 * CON1[3:0] instead of four; the update rate selects the top entry of
	 * the driver's freq_tbl[], i.e. Together they predict CON1 =
	 * 0x46000001, and that is exactly what the same capture read off the
	 * running board.
	 */
	ssogpio: ssogpio@16d00000 {
		compatible = "intel,grx500-ssoled", "syscon";
		reg = <0x16d00000 0x2cc>;

		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;

		clocks = <&cgu GCLK_SSO>, <&sso_fpid>;
		clock-names = "sso", "fpid";

		intel,sso-update-rate-hz = <250000>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ledc>;

		/*
		 * The child must be named "ssoled": the driver matches on the
		 * node name. No label property — colour and function compose
		 * the ABI-visible LED name.
		 */
		ssoled {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * Not a lamp: a brightness carrier driven at a fixed
			 * duty cycle. A child with neither colour nor
			 * function degrades to the name "lgm-sso::".
			 */
			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_WHITE>;
				function = "ambient";
				gpios = <&ssogpio 0 GPIO_ACTIVE_HIGH>;
			};

			/* The two halves of the bicolour info lamp. */
			led_info: led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_GREEN>;
				function = "info";
				gpios = <&ssogpio 2 GPIO_ACTIVE_HIGH>;
			};

			led_info_red: led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_RED>;
				function = "info";
				gpios = <&ssogpio 3 GPIO_ACTIVE_HIGH>;
			};

			led_wlan: led@4 {
				reg = <4>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_WLAN;
				gpios = <&ssogpio 4 GPIO_ACTIVE_HIGH>;
			};

			led@5 {
				reg = <5>;
				color = <LED_COLOR_ID_GREEN>;
				function = "fon";
				gpios = <&ssogpio 5 GPIO_ACTIVE_HIGH>;
			};

			led@6 {
				reg = <6>;
				color = <LED_COLOR_ID_GREEN>;
				function = "connect";
				gpios = <&ssogpio 6 GPIO_ACTIVE_HIGH>;
			};

			/*
			 * The boot loader already lights this lamp;
			 * default-on avoids a dark gap at probe. Active low.
			 */
			led_power: led@7 {
				reg = <7>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_POWER;
				gpios = <&ssogpio 7 GPIO_ACTIVE_LOW>;
				default-state = "on";
			};
		};
	};

	/*
	 * Polled rather than interrupt-driven, as on the FRITZ!Box 7560 and for the
	 * same reason: the GPIO banks publish no irq domain.
	 *
	 * The dect and wlan codes are the FRITZ!Box 7560's exactly, because that
	 * pair is what its failsafe entry is proven against. connect has no
	 * counterpart there; KEY_WPS_BUTTON is what OpenWrt uses for a
	 * button labelled connect or WPS.
	 */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		button-dect {
			label = "dect";
			linux,code = <KEY_PHONE>;
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
		};

		button-wlan {
			label = "wlan";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		};

		button-connect {
			label = "connect";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * The three pads the shift register hangs off: pad 4 is the shift clock,
 * pad 5 the store strobe and pad 6 the data line, all at mux value 1.
 *
 * This is the first pin group on the platform, so it is also the first
 * departure from the rule stated in xrx500.dtsi -- that every consumer
 * claims its pads as plain GPIOs and takes the driver's
 * gpio_request_enable() path, which writes mux 0. These three pads are not
 * GPIOs in this role and none of them is one of the pads that rule exists
 * to protect.
 *
 * Both spellings are needed and neither is optional. "groups" and
 * "function" are what the generic mapping layer reads to build the mux
 * map, and "pins" with "pinmux" are what eqbr_build_groups() reads to
 * learn which pads and which mux value; leave "pinmux" out and the group
 * is not merely ignored, the whole pinmux probe fails. The literal 1 is
 * spelled out because the vendor's EQBR_MUX_1 header is not in this tree.
 * Note also that the group's name is the *value* of "groups" and not the
 * node name.
 */
&pinctrl {
	pinctrl_ledc: led-pins {
		pins = <4>, <5>, <6>;
		function = "led";
		pinmux = <1>, <1>, <1>;
		groups = "led";
	};
};

/*
 * The master LED enable is a plain GPIO, not an SSO pin, and nothing in this
 * tree consumes it — hence the hog. The whole panel is dark while it is low.
 */
&gpio1 {
	led-enable-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "led-enable";
	};
};
