	bool "Smart BUG-handler with extra bugtable-section"
	depends on AVM_ENHANCED

config AVM_WP
	bool "AVM Watchpoint Handler for MIPS 34Kc/InterAptiv"
	depends on MIPS

endmenu
endif # AVM_KERNEL && MIPS
