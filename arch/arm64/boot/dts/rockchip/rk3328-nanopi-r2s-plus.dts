/dts-v1/;

#include "rk3328-nanopi-r2s.dtsi"

/ {
	compatible = "friendlyarm,nanopi-r2s-plus", "rockchip,rk3328";
	model = "FriendlyElec NanoPi R2S Plus";

	aliases {
		mmc1 = &emmc;
	};

	vdd_wifi_3v3: regulator-vdd-wifi-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_wifi_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vdd_5v>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk805 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_reg_on_h>;
		reset-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
	};
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	disable-wp;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
	status = "okay";
};

&io_domains {
	vccio4-supply = <&vcc_io_33>;
	vccio6-supply = <&vcc_18>;
};

&pinctrl {
	wifi {
		wifi_host_wake_h: wifi-host-wake-h {
			rockchip,pins = <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		wifi_reg_on_h: wifi-reg-on-h {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&sdmmc_ext {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0ext_clk &sdmmc0ext_cmd &sdmmc0ext_bus4>;
	sd-uhs-sdr104;
	vmmc-supply = <&vdd_wifi_3v3>;
	vqmmc-supply = <&vcc_18>;
	status = "okay";

	rtl8822cs: wifi@1 {
		reg = <1>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PA1 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_h>;
	};
};
