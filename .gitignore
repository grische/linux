#
drivers/char/avm_net_trace/
drivers/char/avm_new/
drivers/char/avm_power/
drivers/char/tffs/
drivers/dsl/
drivers/isdn/capi_oslib/
drivers/net/avm_cpmac/
drivers/net/avm_coredump/
net/avm_pa/

