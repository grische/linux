show_info = $(if $(V),$(warning $(1)))

ifndef FRITZ_BOX_BUILD_DIR
_dir_to_detect_gu_root := Generate/shell
_levels := $(shell seq 1 $(words $(subst /,$() $(),$(CURDIR))))
_level_to_paths = $(shell printf "%0*d" $(1) 0 | sed -e 's,0,/..,g;s,^,.,')
_walk := . $(foreach num,$(_levels),$(call _level_to_paths,$(num)))
_gu_roots_detected := $(realpath $(addsuffix /$(_dir_to_detect_gu_root)/,$(_walk)))
FRITZ_BOX_BUILD_DIR := $(firstword $(patsubst %/$(_dir_to_detect_gu_root),%,$(_gu_roots_detected)))
$(if $(FRITZ_BOX_BUILD_DIR),,$(error Unable to find GU top-level ($(_dir_to_detect_gu_root) not found)))
export FRITZ_BOX_BUILD_DIR
$(call show_info,Found GU top-level in $(FRITZ_BOX_BUILD_DIR))
endif

ARCH = mips
export ARCH

# Use (cached) CC and CROSS_COMPILE from AVM's build system by default.  May be
# overridden via command line.
CC = mips-buildroot-linux-musl-gcc
export CC
CROSS_COMPILE = mips-buildroot-linux-musl-
export CROSS_COMPILE
CONFIG_CROSS_COMPILE = $(CROSS_COMPILE)
export CONFIG_CROSS_COMPILE

EXTRA_CFLAGS ?= $(if $(KERNEL_EXTRA_CFLAGS),$(KERNEL_EXTRA_CFLAGS),)
export EXTRA_CFLAGS

_prefix_map := $(call cc-option,-ffile-prefix-map=$(FRITZ_BOX_BUILD_DIR)/=/GU/)
_prefix_map += $(call cc-option,-fmacro-prefix-map=$(CURDIR)/=)
_prefix_map += $(call cc-option,-fmacro-prefix-map=$(FRITZ_BOX_BUILD_DIR)/=/GU/)
_prefix_map += $(call cc-option,-fdebug-prefix-map=$(FRITZ_BOX_BUILD_DIR)/=/GU/)

KAFLAGS = $(_prefix_map)
KCFLAGS = $(_prefix_map)
export KAFLAGS KCFLAGS
CFLAGS_KERNEL ?= 
export CFLAGS_KERNEL
CFLAGS_MODULE ?= 
export CFLAGS_MODULE

# Set LOCALVERSION to '$()' to disable auto-vcs mark (e.g. "+" for not-tagged
# versions)
override LOCALVERSION = $()
export LOCALVERSION

ifeq ($(INSTALL_HDR_PATH),)
override INSTALL_HDR_PATH = $(FRITZ_BOX_BUILD_DIR)/KERNEL_grx5_build/src/main/filesystem/usr
$(call show_info,.kernelvariables: Using cached INSTALL_HDR_PATH=$(INSTALL_HDR_PATH))
endif
ifeq ($(INSTALL_MOD_PATH),)
override INSTALL_MOD_PATH = $(FRITZ_BOX_BUILD_DIR)/KERNEL_grx5_build/src/main/filesystem
$(call show_info,.kernelvariables: Using cached INSTALL_MOD_PATH=$(INSTALL_MOD_PATH))
endif
override INSTALL_HDR_PATH := $(INSTALL_HDR_PATH)
override INSTALL_MOD_PATH := $(INSTALL_MOD_PATH)
export INSTALL_HDR_PATH INSTALL_MOD_PATH

INSTALL_MOD_STRIP ?= 1
export INSTALL_MOD_STRIP

CONFIG_DEBUG_SECTION_MISMATCH ?= y
export CONFIG_DEBUG_SECTION_MISMATCH

export AVM_KCONFIG_CONFIG = avm/conf/linux-4.9.grx5

# Enable diffconfig output by default. Comment the following line in
# <KGW>/templates/kbuild/kernelvariables to disable.
kgw_enable_diffconfig_output = y

