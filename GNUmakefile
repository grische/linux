# GNUmakefile for Linux sources  *** auto-generated by kernel/gu-wrapper *** -- v3
#
# This GNUmakefile sources .kernelvariables (which should be auto-generated by
# AVM GU on almost every call to the GU-Kernel-Makefile) to ensure correct
# environment variables for direct kernel _and_ external module builds.

# Disable parallel make rule processing in _this_ make instance to prevent
# copying modules.{order,builtin} twice.
.NOTPARALLEL:

.DEFAULT_GOAL := recurse-wo-goal

KBUILD_OUTPUT ?= $(O)
KCONFIG_CONFIG ?= $(if $(KBUILD_OUTPUT),$(KBUILD_OUTPUT)/).config
KBUILD_BUILD_TIMESTAMP ?= $(if $(SOURCE_DATE_EPOCH),$(shell LC_TIME=C date +%Y-%m-%d -d @$(SOURCE_DATE_EPOCH)))
export KBUILD_BUILD_TIMESTAMP

-include scripts/Kbuild.include
kernelvariables = $(sort $(realpath $(wildcard $(addsuffix /.kernelvariables,$(O) $(KBUILD_OUTPUT) $(CURDIR)))))
ifneq ($(lastword $(kernelvariables)),$(kernelvariables))
$(error Found multiple .kernelvariables files: $(kernelvariables))
endif
$(if $(kernelvariables),,$(warning No .kernelvariables file found!))

ifeq ($(_kernelvariables_read),)
-include ../makefiles/avm-git-branch-check.make
ifneq (,$(V))
$(if $(kernelvariables),$(info linux/GNUmakefile: including $(kernelvariables)))
endif
export _kernelvariables_read := 1
-include $(kernelvariables)

# Iff /GU/tmp/ is not available and CCACHE_DISABLE is not set, disable ccache
ifeq ($(wildcard /GU/tmp/)$(CCACHE_DISABLE),)
ifneq (,$(V))
$(info /GU/tmp is not available, disabling ccache)
endif
export CCACHE_DISABLE = true
endif
endif

# Prevent accidental influence of user space targeted settings in standard
# compiler environment variables to kernel or kernel module builds.
export CFLAGS =
export CXXFLAGS =
export CPPFLAGS =
export LDFLAGS =

avm-subprojects = $(patsubst %/avm/conf/compat,%,\
	$(shell find $(patsubst $(CURDIR)/%/.,%,$(wildcard $(CURDIR)/*/.)) -type f -regex '.*/avm/conf/compat$$'))
export AVM_SUBPROJECTS_PATHS = $(avm-subprojects)

## Detect and auto-remove symlinks in include/linux/ pointing into
## LiSI-compliant subproject
## TODO: move all this creapy search/find/replace stuff into a seperate script

# find all symlinks below include/linux/
symlinks-in-include = $(strip \
	$(patsubst $(CURDIR)/%,%,\
		$(shell find include/linux/ include/uapi/linux/ -type l | \
			awk '{printf $$1 " "; system("readlink -m " $$1)}' | \
			awk '{print $$2 ":" $$1}')))

# filter all symlinks pointing into LiSI compliant
obsolete-symlinks-in-include := \
	$(foreach pair,$(filter $(addsuffix /%,$(avm-subprojects)),$(symlinks-in-include)),\
		$(word 2,$(subst :, ,$(pair))))
ifneq (,$(obsolete-symlinks-in-include))
$(warning Removing obsolete symlinks below include/linux/:)
$(foreach link,$(obsolete-symlinks-in-include),\
	$(info REMOVE $(link))$(shell rm -f $(link)))
$(warning There had been obsolete symlinks, which are now removed)
$(error Please re-start the kernel build.  Good luck..)
endif

USERINCLUDE_AVM_SUBPROJECTS = \
	$(foreach path,$(avm-subprojects),\
		-I$(path)/include/uapi \
		$(if $(O), -I$(CURDIR)/$(path)/include/uapi)) \

LINUXINCLUDE_AVM_SUBPROJECTS = \
	$(foreach path,$(avm-subprojects),\
		-I$(path)/include \
		$(if $(O), -I$(CURDIR)/$(path)/include)) \
	-Iinclude/generated/lisi

# ACHTUNG: Make wird hier neugestartet um die Übernahme der
# Variablenzuweisungen aus .kernelvariables auch in allen Sub-Shells zu
# erzwingen.
non-default-targets += $(KCONFIG_CONFIG)
no-config-diff-targets += help
no-config-diff-targets += mrproper
no-config-diff-targets += distclean
no-config-diff-targets += kernelrelease
no-config-diff-targets += kernelversion
no-config-diff-targets += tags TAGS
no-config-diff-targets += cscope
no-config-diff-targets += gtags
no-config-diff-targets += headers_install
no-config-diff-targets += checkstack
no-config-diff-targets += namespacecheck
no-config-diff-targets += versioncheck
no-config-diff-targets += includecheck
no-config-diff-targets += export_report
no-config-diff-targets += headers_check
no-config-diff-targets += headerdep
no-config-diff-targets += coccicheck
no-config-diff-targets += kselftest
no-config-diff-targets += kselftest-clean
no-config-diff-targets += kselftest-merge
no-config-diff-targets += installmandocs
no-config-diff-targets += cleandocs

recurse-goals := $(filter-out $(non-default-targets),$(MAKECMDGOALS))
recurse-wo-goal $(filter-out $(non-default-targets),$(MAKECMDGOALS)): $(KCONFIG_CONFIG) force
	$(if $(filter mrproper,$@),\
		@rm -f .kernelvariables .kernelvariables.old)
	@$(MAKE) -f Makefile $(if $(O),O=$(O)) $(if $(MAKECMDGOALS),$@,) \
		$(if $(INSTALL_HDR_PATH),INSTALL_HDR_PATH=$(INSTALL_HDR_PATH)) \
		$(if $(GU_MAKE_J_OPTION),-j$(GU_MAKE_J_OPTION)) \
		avm-subprojects='$(avm-subprojects)' \
		USERINCLUDE_AVM_SUBPROJECTS='$(USERINCLUDE_AVM_SUBPROJECTS)' \
		LINUXINCLUDE_AVM_SUBPROJECTS='$(LINUXINCLUDE_AVM_SUBPROJECTS)'
	@# Skip config diff for out-of-tree module builds
ifeq ($(KBUILD_EXTMOD)$(M),)
    ifeq ($(words $(sort $(AVM_KCONFIG_CONFIG) $(KCONFIG_CONFIG))),2)
	$(if $(filter-out $(no-config-diff-targets),$@),\
		@scripts/diffconfig $(AVM_KCONFIG_CONFIG) $(KCONFIG_CONFIG) | \
		 sed -re '1{s|^|Linux config has changed compared to $(AVM_KCONFIG_CONFIG):\n|}' >&2)
    endif
endif

$(KCONFIG_CONFIG): $(wildcard $(AVM_KCONFIG_CONFIG))
	$(if $<,@echo "UPD $< -> $@")
	$(if $<,@mkdir -p $(@D))
	$(if $<,@cat </dev/null $< >$@)

_kernelrelease = $(shell cat include/config/kernel.release 2> /dev/null)
_modlib	= $(INSTALL_MOD_PATH)/lib/modules/$(_kernelrelease)

modules_install: $(_modlib)/modules.order
modules_install: $(_modlib)/modules.builtin

_depmod_deps = modules.order modules.builtin
_depmod_dep_srcs = $(wildcard $(foreach file,$(_depmod_deps),$(foreach path,source/ ./,$(path)$(file))))
$(addprefix $(_modlib)/,$(_depmod_deps)): $(_modlib)/%:
ifneq ($(_depmod_dep_srcs),)
	@echo "  COPY $(_depmod_deps) -> $(dir $@)"
	@mkdir -p $(dir $@)
	@cp -auv $(_depmod_dep_srcs) $(dir $@) || touch $@
endif

force: ;

