  ifneq ($(kgw_enable_diffconfig_output),)
	@# Skip config diff for out-of-tree module builds and if requested
    ifeq ($(words $(wildcard $(sort $(AVM_KCONFIG_CONFIG) $(KCONFIG_CONFIG)))),2)
	$(if $(filter-out $(no-config-diff-targets),$@),\
