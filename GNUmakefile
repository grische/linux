ifneq ($(KBUILD_EXTMOD)$(M),)
# Disable depmod for oot modules, may be overridden.
DEPMOD = true
endif
export DEPMOD


# When installing out-of-tree modules, move lib/modules/modules.* to
# lib/modules/modules.*.d/PROJECT/$(notdir $(M)$(KBUILD_EXTMOD)); but not
# modules.builtin{,.bin}.
kmod-ddir-target = $(1).d/$(2)$(suffix $(1))
kmod-name = $(addsuffix /,$(GU_PROJECT_NAME))$(notdir $(M)$(KBUILD_EXTMOD))
cmd-move-to-dot-d-dir = ( mkdir -p $(dir $(2)) && mv -v $(1) $(2) )
move-to-dot-d-dir = \
	$(call cmd-move-to-dot-d-dir,\
		$(1),$(call kmod-ddir-target,$(1),$(kmod-name)))
filter-dirs = $(patsubst %/.,%,$(wildcard $(addsuffix /.,$(1))))
filter-out-dirs = $(filter-out $(call filter-dirs,$(1)),$(1))
kmod-move-files-to-dot-dir = \
	$(foreach kmod-file,$(call filter-out-dirs,$(1)),\
	  $(call move-to-dot-d-dir,$(kmod-file)) &&) true

non-default-targets += modules_install.post
.PHONY: modules_install.post
ifeq ($(GU_PROJECT_NAME),)
modules_install.post: force
	@true
else
# Taken from linux/Makefile
# Read KERNELRELEASE from include/config/kernel.release (if it exists)
_kernelrelease = $(shell cat $(addsuffix /,$(firstword $(O) $(KBUILD_OUTPUT)))include/config/kernel.release 2> /dev/null)
_modlib = $(INSTALL_MOD_PATH)/lib/modules/$(_kernelrelease)

# modules_install.post: Rename $(MODLIB)/modules.* only for GU-API2 projects
modules_install.post: force
	$(call kmod-move-files-to-dot-dir,\
		$(filter-out %/modules.builtin %/modules.builtin.bin,\
			$(wildcard $(_modlib)/modules.* $(_modlib)/Module.*)))
endif


# Macro for explicitly forwarding make variables to child instance
forward_var = $(if $($(1)),$(1)=$($(1)))

recurse-wo-goal $(filter-out $(non-default-targets),$(MAKECMDGOALS)): $(KCONFIG_CONFIG) force
	$(if $(filter mrproper,$@),\
		@rm -f .kernelvariables .kernelvariables.old)
	@$(MAKE) -f Makefile $(if $(MAKECMDGOALS),$@,) \
		$(call forward_var,O) \
		$(call forward_var,KBUILD_OUTPUT) \
		$(call forward_var,M) \
		$(call forward_var,KBUILD_EXTMOD) \
		$(call forward_var,INSTALL_MOD_PATH) \
		$(call forward_var,INSTALL_HDR_PATH) \
		$(call forward_var,DEPMOD) \
		avm-subprojects='$(avm-subprojects)' \
		USERINCLUDE_AVM_SUBPROJECTS='$(USERINCLUDE_AVM_SUBPROJECTS)' \
		LINUXINCLUDE_AVM_SUBPROJECTS='$(LINUXINCLUDE_AVM_SUBPROJECTS)'
	@# Skip config diff for out-of-tree module builds
ifeq ($(KBUILD_EXTMOD)$(M),)
    ifeq ($(words $(wildcard $(sort $(AVM_KCONFIG_CONFIG) $(KCONFIG_CONFIG)))),2)
	$(if $(filter-out $(no-config-diff-targets),$@),\
		@scripts/diffconfig $(AVM_KCONFIG_CONFIG) $(KCONFIG_CONFIG) | \
		 sed -re '1{s|^|Linux config has changed compared to $(AVM_KCONFIG_CONFIG):\n|}' >&2)
    endif
else
	$(if $(filter modules_install,$@),\
		@$(MAKE) --no-print-directory modules_install.post)
endif


$(KCONFIG_CONFIG): $(wildcard $(AVM_KCONFIG_CONFIG))
	$(if $<,@echo "UPD $< -> $@")
	$(if $<,@mkdir -p $(@D))
	$(if $<,@cat </dev/null $< >$@)

_kernelrelease = $(shell cat include/config/kernel.release 2> /dev/null)
_modlib	= $(INSTALL_MOD_PATH)/lib/modules/$(_kernelrelease)

ifneq ($(M)$(KBUILD_EXTMOD),)
# Install Module.symvers from out-of-tree modules into
# $(_modlib)/build/$(project)-$(target).symvers where it can be found and used
# by scripts/add-file-helpers/check-abi-compat.

# $(GENERIC_NAME) has to be kept as long as there is at least one GU project
# that requires GU-API 1.x.  Setting SYMVERS_NAME when calling
# 'modules_install' allows oot kmods to explicitly set a proper basename for
# their symvers file.
project = $(or $(SYMVERS_NAME),$(or $(GU_PROJECT_NAME),$(GENERIC_NAME))$(and $(GU_TARGET),-$(GU_TARGET)))

$(_modlib)/build/$(project).symvers: $(firstword $(M) $(KBUILD_EXTMOD))/Module.symvers
	@echo "  APPEND $< -> $@"
	@# When sponge becomes available, possibly switch to something like
	@# flock --exclusive $@ sh -c '(sort -u $@ $< | sponge)'
	@mkdir -p $(@D)
	@flock --exclusive $@ --command cat <$< >>$@

modules_install: $(_modlib)/build/$(project).symvers
endif

force: ;

