# This GNUmakefile sources .kernelvariables (which should be auto-generated by
# AVM GU on almost every call to the GU-Kernel-Makefile) to ensure correct
# environment variables for direct kernel _and_ external module builds.

# Disable parallel make rule processing in _this_ make instance to prevent
# copying modules.{order,builtin} twice.
.NOTPARALLEL:

.DEFAULT_GOAL := recurse-wo-goal

KBUILD_OUTPUT ?= $(O)
KCONFIG_CONFIG ?= $(if $(KBUILD_OUTPUT),$(KBUILD_OUTPUT)/).config

# If SOURCE_DATE_EPOCH is set, we assume that reproducible output is requested.
# Thus, complete the reproducibility features by also setting KBUILD_BUILD_USER
# and KBUILD_BUILD_HOST
KBUILD_BUILD_TIMESTAMP ?= $(if $(SOURCE_DATE_EPOCH),$(shell LC_TIME=C date +%Y-%m-%d -d @$(SOURCE_DATE_EPOCH)))
KBUILD_BUILD_USER ?= $(if $(SOURCE_DATE_EPOCH),kbuild-team)
KBUILD_BUILD_HOST ?= $(if $(SOURCE_DATE_EPOCH),core.avm.de)
export KBUILD_BUILD_TIMESTAMP
export KBUILD_BUILD_USER
export KBUILD_BUILD_HOST

-include scripts/Kbuild.include
kernelvariables = $(sort $(realpath $(wildcard $(addsuffix /.kernelvariables,$(O) $(KBUILD_OUTPUT) $(CURDIR)))))
ifneq ($(lastword $(kernelvariables)),$(kernelvariables))
$(error Found multiple .kernelvariables files: $(kernelvariables))
endif
$(if $(kernelvariables),,$(warning No .kernelvariables file found!))

ifeq ($(_kernelvariables_read),)
-include ../makefiles/avm-git-branch-check.make
ifneq (,$(V))
$(if $(kernelvariables),$(info linux/GNUmakefile: including $(kernelvariables)))
endif
export _kernelvariables_read := 1
-include $(kernelvariables)

# Iff /GU/tmp/ is not available and CCACHE_DISABLE is not set, disable ccache
ifeq ($(wildcard /GU/tmp/)$(CCACHE_DISABLE),)
ifneq (,$(V))
$(info /GU/tmp is not available, disabling ccache)
endif
export CCACHE_DISABLE = true
endif
endif

# Prevent accidental influence of user space targeted settings in standard
# compiler environment variables to kernel or kernel module builds.
export CFLAGS =
export CXXFLAGS =
export CPPFLAGS =
export LDFLAGS =

avm-subprojects = $(patsubst %/avm/conf/compat,%,\
	$(shell find $(patsubst $(CURDIR)/%/.,%,$(wildcard $(CURDIR)/*/.)) -type f -regex '.*/avm/conf/compat$$'))
export AVM_SUBPROJECTS_PATHS = $(avm-subprojects)

USERINCLUDE_AVM_SUBPROJECTS = \
	$(foreach path,$(avm-subprojects),\
		$(addprefix -I,$(wildcard $(and $(or $(O),$(KBUILD_OUTPUT)),$(CURDIR)/)$(path)/include/uapi)))

LINUXINCLUDE_AVM_SUBPROJECTS = \
	$(foreach path,$(avm-subprojects),\
		$(addprefix -I,$(wildcard $(and $(or $(O),$(KBUILD_OUTPUT)),$(CURDIR)/)$(path)/include)))

# ACHTUNG: Make wird hier neugestartet um die Übernahme der
# Variablenzuweisungen aus .kernelvariables auch in allen Sub-Shells zu
