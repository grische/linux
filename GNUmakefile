ifneq ($(is-oot-kmod),)
# Install Module.symvers from out-of-tree modules into
# $(_modlib)/build/$(project)-$(target).symvers where it can be found and used
# by scripts/add-file-helpers/check-abi-compat.

# $(GENERIC_NAME) has to be kept as long as there is at least one GU project
# that requires GU-API 1.x.  Setting SYMVERS_NAME when calling
# 'modules_install' allows oot kmods to explicitly set a proper basename for
# their symvers file.
project = $(or $(SYMVERS_NAME),$(or $(GU_PROJECT_NAME),$(GENERIC_NAME))$(and $(GU_TARGET),-$(GU_TARGET)))

$(_modlib)/build/$(project).symvers: $(kbuild-extmod)/Module.symvers FORCE
	$(Q)mkdir -p $(@D)
	$(Q)set -e; \
	trap 'rm -f $(dot-target)' EXIT; \
	[ -e $@ ] || touch $@; \
	exec 23>>$@; \
	flock --exclusive 23; \
	{ \
		awk '{print $$3}' <$< | sort -u | grep -vhf- $@ || true; \
		cat $<; \
	} | sort -u -k2 >$(dot-target); \
	if ! cmp -s $(dot-target) $@ 2>/dev/null; then \
		echo "  UPD     $< -> $@"; \
		cat $(dot-target) >$@; \
	fi

modules_install: $(_modlib)/build/$(project).symvers
endif

