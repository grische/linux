kbuild-extmod = $(KBUILD_EXTMOD)$(M)

# Special handling for out-of-tree kernel modules
ifneq ($(kbuild-extmod),)
is-oot-kmod := 1

# Abort iff KBUILD_EXTMOD and M are given and both are not equal.
ifneq ($(sort $(M) $(KBUILD_EXTMOD)), $(kbuild-extmod))
$(error Only one of KBUILD_EXTMOD and M should be used (KBUILD_EXTMOD=$(KBUILD_EXTMOD), M=$(M)))
endif

# Check against multiple kextmod dirs, taken from upstream commit bcf637f54f6d
# ("kbuild: parse C= and M= before changing the working directory", 2021-02-22)
$(if $(word 2, $(kbuild-extmod)), \
	$(error building multiple external modules is not supported))

# Disable depmod for oot modules, may be overridden.
DEPMOD = true
export DEPMOD

# When installing out-of-tree modules, move lib/modules/modules.* to
# lib/modules/modules.*.d/PROJECT/$(notdir $(kbuild-extmod)); but not
# modules.builtin{,.bin}.
kmod-ddir-target = $(1).d/$(2)$(suffix $(1))
kmod-name = $(addsuffix /,$(GU_PROJECT_NAME))$(notdir $(kbuild-extmod))
cmd-move-to-dot-d-dir = ( mkdir -p $(dir $(2)) && mv -v $(1) $(2) )
move-to-dot-d-dir = \
	$(call cmd-move-to-dot-d-dir,\
		$(1),$(call kmod-ddir-target,$(1),$(kmod-name)))
filter-dirs = $(patsubst %/.,%,$(wildcard $(addsuffix /.,$(1))))
filter-out-dirs = $(filter-out $(call filter-dirs,$(1)),$(1))
kmod-move-files-to-dot-dir = \
	$(foreach kmod-file,$(call filter-out-dirs,$(1)),\
	  $(call move-to-dot-d-dir,$(kmod-file)) &&) true

# Copy definitions for abs_srctree and objtree from 6.14 kbuild.
_kgw_this-makefile := $(lastword $(MAKEFILE_LIST))
_kgw_abs_srctree := $(realpath $(dir $(_kgw_this-makefile)))
ifeq ($(KBUILD_OUTPUT),)
    _kgw_objtree := $(_kgw_abs_srctree)
else
    _kgw_objtree := $(realpath $(KBUILD_OUTPUT))
endif

# When building external kmods, add all *.symvers files from other external
# kmods to KBUILD_EXTRA_SYMBOLS to prevent modpost warnings and errors.  This
# makes hard-coded KBUILD_EXTRA_SYMBOLS definitions in several non-kernel GU
# projects obsolete.
ifeq ($(origin _kgw_kbuild_extra_symbols),undefined)
_kgw_kbuild_extra_symbols := $(filter-out $(_kgw_objtree)/Module.symvers, \
			       $(sort $(wildcard $(_kgw_objtree)/*.symvers)))
export _kgw_kbuild_extra_symbols
endif
_kgw_add_extra_symbols := $(filter-out $(KBUILD_EXTRA_SYMBOLS), $(_kgw_kbuild_extra_symbols))

export KBUILD_EXTRA_SYMBOLS := $(KBUILD_EXTRA_SYMBOLS) $(_kgw_add_extra_symbols)
endif

# Macro for explicitly forwarding make variables to child instance
forward_var = $(if $($(1)),$(1)=$($(1)))

define __kbuild
	$(MAKE) -f Makefile $(1) \
		$(call forward_var,O) \
		$(call forward_var,KBUILD_OUTPUT) \
		$(call forward_var,M) \
		$(call forward_var,KBUILD_EXTMOD) \
		$(call forward_var,INSTALL_MOD_PATH) \
		$(call forward_var,INSTALL_HDR_PATH) \
		$(call forward_var,DEPMOD) \
		avm-subprojects='$(avm-subprojects)' \
		USERINCLUDE_AVM_SUBPROJECTS='$(USERINCLUDE_AVM_SUBPROJECTS)' \
		LINUXINCLUDE_AVM_SUBPROJECTS='$(LINUXINCLUDE_AVM_SUBPROJECTS)' \
		$(2)
endef

stage-hash := $(if $(is-oot-kmod),$(firstword $(shell echo "$(kbuild-extmod)" | md5sum)))
kmod-debug-install-dir = $(INSTALL_MOD_PATH)/usr/lib/debug
kmod-debug-install-staged = $(kmod-debug-install-dir)/.tmp.stage.$(stage-hash)

# Taken from linux/Makefile
# Read KERNELRELEASE from include/config/kernel.release (if it exists)
_kernelrelease = $(shell cat $(addsuffix /,$(firstword $(O) $(KBUILD_OUTPUT)))include/config/kernel.release 2> /dev/null)
_modlib = $(INSTALL_MOD_PATH)/lib/modules/$(_kernelrelease)

ifneq ($(is-oot-kmod),)
non-default-targets += modules_install.post
.PHONY: modules_install.post
modules_install.post: FORCE modules_install
ifneq ($(GU_PROJECT_NAME),)
	# modules_install.post: Rename $(MODLIB)/modules.* only for GU-API2 projects
	$(call kmod-move-files-to-dot-dir,\
		$(filter-out %/modules.builtin %/modules.builtin.bin,\
			$(wildcard $(_modlib)/modules.* $(_modlib)/Module.*)))
endif
	@echo 'INSTALL oot kmods w/ debug symbols to $(kmod-debug-install-dir:$(INSTALL_MOD_PATH)/%=%)'
	$(Q)rm -rf $(kmod-debug-install-staged)
	$(Q)mkdir -p $(kmod-debug-install-staged)
	echo $(call __kbuild,$@,INSTALL_MOD_PATH=$(kmod-debug-install-staged) INSTALL_MOD_STRIP= DEPMOD=true)
	+$(call __kbuild,modules_install,INSTALL_MOD_PATH=$(kmod-debug-install-staged) INSTALL_MOD_STRIP= DEPMOD=true)
	@echo '  OBJCOPY adding debug links to stripped kernel modules'
	@# Install unstripped kmods into stage dir to be able to process each
	@# module without accidentally catching something different from
	@# $(INSTALL_MOD_PATH)..
	$(Q)set -e -u -o pipefail; \
	trap 'rm -rf $(kmod-debug-install-staged)' EXIT; \
	find "$(kmod-debug-install-staged)" -name '*.ko' -printf '%P\n' | \
	while read -r module; do \
		install -m 644 -D "$(kmod-debug-install-staged)/$${module}" "$(kmod-debug-install-dir)/$${module}"; \
		$(CROSS_COMPILE)objcopy --add-gnu-debuglink=$(kmod-debug-install-dir)/$${module} $(INSTALL_MOD_PATH)/$${module}; \
	done
	@# stripping the modules removes signatures as well - if automated signing is enabled with
	@# an ephemeral key, re-do the sign step
	+$(Q)if grep -qs '^CONFIG_MODULE_SIG_ALL=y' $(LINUX_KERNEL_BUILDDIR)/.config; then \
		echo "Re-signing oot kernel modules is not implemented, yet" >&2; \
		exit 1; \
	fi
endif

