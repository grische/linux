config NET_DSA_LANTIQ_COMMON
	tristate
	select REGMAP
	select REGMAP_MMIO

config NET_DSA_LANTIQ_GSWIP
	tristate "Lantiq / Intel GSWIP"
	depends on HAS_IOMEM
	select NET_DSA_TAG_GSWIP
	select NET_DSA_LANTIQ_COMMON
	help
	  This enables support for the Lantiq / Intel GSWIP 2.1 found in
	  the xrx200 / VR9 SoC.

config NET_DSA_LANTIQ_GSWIP_XRX500
	tristate "Lantiq / Intel GSWIP 3.0"
	depends on INTEL_MIPS || COMPILE_TEST
	depends on HAS_IOMEM
	depends on RESET_CONTROLLER
	select FW_LOADER
	select NET_DSA_TAG_GSWIP3
	select NET_DSA_LANTIQ_COMMON
	#
	# The reset lines of the integrated PHYs come from the SoC's own
	# reset controller, whose driver has no prompt of its own and
	# defaults to a system type this family is not. Without it every
	# reset lookup defers forever and the switch never probes, so the
	# one driver that needs it asks for it, along with the register
	# window it reads its status through.
	#
	select MFD_SYSCON if INTEL_MIPS
	select RESET_LANTIQ if INTEL_MIPS
	help
	  This enables support for the two Lantiq / Intel GSWIP 3.0 switch
	  macros found in the xRX500 SoC family.

	  The integrated PHYs need their firmware from the file system, which
	  a built-in driver cannot reach when it probes, so build this as a
	  module.
