# Phy drivers for Intel platforms
#
config PHY_INTEL_GRX500_PCIE
	tristate "Intel GRX500 PCIe slim PHY driver"
	depends on INTEL_MIPS || COMPILE_TEST
	depends on OF && HAS_IOMEM
	select GENERIC_PHY
	select MFD_SYSCON
	select RESET_CONTROLLER
	help
	  Enable this to support the PCIe slim PHY that feeds the on-chip
	  PCIe host bridges of the Intel MIPS (xRX500/GRX500) SoC family.
	  Besides its own PDI register block the driver drives the shared
	  LCPLL spread-spectrum generator in the CGU and the per-instance
	  reference clock gate in the chip-top interface mux.

	  To compile this driver as a module, choose M here: the module
	  will be called phy-intel-grx500-pcie.ko.

config PHY_INTEL_GRX500_USB
	tristate "Intel GRX500 USB PHY driver"
	depends on INTEL_MIPS || COMPILE_TEST
	depends on OF && HAS_IOMEM
	select GENERIC_PHY
	select MFD_SYSCON
	select RESET_CONTROLLER
	select RESET_LANTIQ
	help
	  Enable this to support the USB PHYs that feed the on-chip DWC3
	  controllers of the Intel MIPS (xRX500/GRX500) SoC family. Besides
	  its own gate clock, reset line and optional VBUS supply the driver
	  owns the AXI endianness field its controller needs in the chip-top
	  syscon, which on this big-endian SoC has to be set before the
	  controller does any DMA.

	  To compile this driver as a module, choose M here: the module
	  will be called phy-intel-grx500-usb.ko.

config PHY_INTEL_KEEMBAY_EMMC
	tristate "Intel Keem Bay EMMC PHY driver"
	depends on ARCH_KEEMBAY || COMPILE_TEST
	depends on HAS_IOMEM
	select GENERIC_PHY
	select REGMAP_MMIO
	help
	  Choose this option if you have an Intel Keem Bay SoC.

	  To compile this driver as a module, choose M here: the module
	  will be called phy-keembay-emmc.ko.

config PHY_INTEL_KEEMBAY_USB
	tristate "Intel Keem Bay USB PHY driver"
	depends on ARCH_KEEMBAY || COMPILE_TEST
	depends on HAS_IOMEM
	select GENERIC_PHY
	select REGMAP_MMIO
	help
	  Choose this option if you have an Intel Keem Bay SoC.

	  To compile this driver as a module, choose M here: the module
	  will be called phy-keembay-usb.ko.

config PHY_INTEL_LGM_COMBO
	bool "Intel Lightning Mountain ComboPHY driver"
	depends on X86 || COMPILE_TEST
	depends on OF && HAS_IOMEM
	select MFD_SYSCON
	select GENERIC_PHY
	select REGMAP
	help
	  Enable this to support Intel ComboPhy.

	  This driver configures ComboPhy subsystem on Intel gateway
	  chipsets which provides PHYs for various controllers, EMAC,
	  SATA and PCIe.

config PHY_INTEL_LGM_EMMC
	tristate "Intel Lightning Mountain EMMC PHY driver"
	depends on X86 || COMPILE_TEST
	select GENERIC_PHY
	help
	  Enable this to support the Intel EMMC PHY
