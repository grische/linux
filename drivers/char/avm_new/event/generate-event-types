#!/bin/sh

set -eu

target="${objtree}/${obj}/event/struct"
work="${objtree}/${obj}/event/struct/.build.tmp"

srctree="$(realpath ${1%${obj}})"
struct="${srctree}/${obj}/event/struct"

trap "rm -rf ${work}" EXIT
mkdir -p ${work}

(
	: ${PERL5LIB:=}
	export PERL5LIB="$PERL5LIB:${struct}"

	cd "${work}"
	perl ${struct}/avm_event_generate.pl 1>/dev/null 2>&1
)

rsync --quiet --recursive --checksum "${work}/" "${target}/"

cat ${target}/avm_event_gen_types.h
